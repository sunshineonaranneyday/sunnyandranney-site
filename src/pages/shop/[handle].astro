</style>

<script>
  import { STORE_PHONE, emailSuggestion, fieldError, splitContact } from '@/lib/special-order-request.mjs';
  import { addLines, buyNow, recentlyViewed } from '@/lib/cart-store';

  // Clean up previous keydown listener on re-init (View Transitions)
  let _pdpKeyHandler: ((e: KeyboardEvent) => void) | null = null;

  document.addEventListener('astro:page-load', () => {
  // ─── DOM refs ───────────────────────────────
  const thumbs = document.querySelectorAll('.pdp-thumb');
  if (!document.getElementById('pdp-price-area')) return; // not a product page
  const mainImg = document.getElementById('main-product-image') as HTMLImageElement;
  const galleryMain = document.getElementById('gallery-main');
  const variantBtns = document.querySelectorAll('.pdp-variant-btn');
  const addToCartBtn = document.getElementById('add-to-cart') as HTMLButtonElement;
  const selectedLabel = document.getElementById('selected-variant-label');
  const currentPriceEl = document.getElementById('pdp-current-price');
  const comparePriceEl = document.getElementById('pdp-compare-price');
  const qtyInput = document.getElementById('qty-input') as HTMLInputElement;
  const qtyMinus = document.getElementById('qty-minus');
  const qtyPlus = document.getElementById('qty-plus');
  const stickyBar = document.getElementById('sticky-bar');
  const stickyAdd = document.getElementById('sticky-add');
  const stickyPrice = document.getElementById('sticky-price');
  const stickyHeader = document.getElementById('sticky-header');
  const stickyHeaderAdd = document.getElementById('sticky-header-add');
  const stickyHeaderPrice = document.getElementById('sticky-header-price');
  const urgencyEl = document.getElementById('pdp-urgency');
  const stockCountEl = document.getElementById('stock-count');

  // Smart price formatter — drops .00 on whole numbers ($800 not $800.00)
  function fmtPrice(amount: number): string {
    return amount % 1 === 0 ? `$${amount.toLocaleString()}` : `$${amount.toFixed(2)}`;
  }

  // Must match server-side cfImage() in src/lib/images.ts
  function cfImg(url: string, width = 900) {
    if (!url || !url.includes('cdn.shopify.com')) return url;
    const sep = url.includes('?') ? '&' : '?';
    return `${url}${sep}width=${width}&crop=center&quality=70&format=webp`;
  }

  // Must match server-side cfSrcset() widths passed in the template
  const PDP_WIDTHS = [450, 900, 1400];

  function cfSrcsetJs(url: string) {
    if (!url) return '';
    return PDP_WIDTHS.map(w => `${cfImg(url, w)} ${w}w`).join(', ');
  }

  /** Swap the main product image — updates src, srcset, and alt in one place. */
  let _swapTimer = 0;
  function updateMainImage(url: string, alt?: string) {
    if (!mainImg) return;
    clearTimeout(_swapTimer);
    mainImg.onload = null;
    mainImg.style.opacity = '0';
    _swapTimer = window.setTimeout(() => {
      mainImg.srcset = cfSrcsetJs(url);
      mainImg.src = cfImg(url);
      if (alt !== undefined) mainImg.alt = alt;
      mainImg.onload = () => { mainImg.style.opacity = '1'; };
    }, 150);
  }

  // ─── Image data ─────────────────────────────
  const imageUrls = Array.from(thumbs).map(t => (t as HTMLElement).dataset.url || '');
  if (mainImg && !imageUrls.length) imageUrls.push(mainImg.src);
  let currentImageIdx = 0;
  const galleryDots = document.querySelectorAll('.pdp-dot');

  function syncDots(idx: number) {
    galleryDots.forEach((d, i) => d.classList.toggle('pdp-dot--active', i === idx));
  }

  // Dot click → change image
  galleryDots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      currentImageIdx = i;
      syncDots(i);
      thumbs.forEach(t => t.classList.remove('pdp-thumb--active'));
      thumbs[i]?.classList.add('pdp-thumb--active');
      updateMainImage(imageUrls[i]);
    });
  });

  // ─── Mobile swipe on gallery ───────────────
  if (galleryMain && imageUrls.length > 1) {
    let swipeStartX = 0;
    let swipeStartY = 0;
    let swiping = false;

    galleryMain.addEventListener('touchstart', (e: TouchEvent) => {
      swipeStartX = e.touches[0].clientX;
      swipeStartY = e.touches[0].clientY;
      swiping = true;
    }, { passive: true });

    galleryMain.addEventListener('touchend', (e: TouchEvent) => {
      if (!swiping) return;
      swiping = false;
      const dx = e.changedTouches[0].clientX - swipeStartX;
      const dy = e.changedTouches[0].clientY - swipeStartY;
      // Only trigger on horizontal swipe > 50px with horizontal > vertical
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        const newIdx = dx < 0
          ? Math.min(currentImageIdx + 1, imageUrls.length - 1)
          : Math.max(currentImageIdx - 1, 0);
        if (newIdx !== currentImageIdx) {
          currentImageIdx = newIdx;
          syncDots(currentImageIdx);
          thumbs.forEach(t => t.classList.remove('pdp-thumb--active'));
          thumbs[currentImageIdx]?.classList.add('pdp-thumb--active');
          updateMainImage(imageUrls[currentImageIdx]);
        }
      }
    }, { passive: true });
  }

  // ─── Thumbnail gallery (images + videos) ──────
  const videoContainer = document.createElement('div');
  videoContainer.className = 'pdp-video-container';
  videoContainer.style.display = 'none';
  galleryMain?.appendChild(videoContainer);

  let isShowingVideo = false;

  thumbs.forEach((thumb, i) => {
    thumb.addEventListener('click', () => {
      const el = thumb as HTMLElement;
      const type = el.dataset.type;

      thumbs.forEach(t => t.classList.remove('pdp-thumb--active'));
      thumb.classList.add('pdp-thumb--active');

      if (type === 'video') {
        // Show video
        const videoUrl = el.dataset.videoUrl || '';
        const videoType = el.dataset.videoType;

        if (mainImg) mainImg.style.display = 'none';
        videoContainer.style.display = 'flex';
        isShowingVideo = true;

        // Clear previous video content safely
        videoContainer.replaceChildren();

        if (videoType === 'VIDEO') {
          const video = document.createElement('video');
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          video.className = 'pdp-video';
          const source = document.createElement('source');
          source.src = videoUrl;
          source.type = 'video/mp4';
          video.appendChild(source);
          videoContainer.appendChild(video);
        } else if (videoType === 'EXTERNAL_VIDEO') {
          const iframe = document.createElement('iframe');
          iframe.className = 'pdp-video';
          iframe.src = videoUrl;
          iframe.setAttribute('frameborder', '0');
          iframe.allowFullscreen = true;
          iframe.allow = 'autoplay';
          videoContainer.appendChild(iframe);
        }
      } else {
        // Show image
        if (isShowingVideo) {
          videoContainer.replaceChildren();
          videoContainer.style.display = 'none';
          if (mainImg) mainImg.style.display = '';
          isShowingVideo = false;
        }

        currentImageIdx = i;
        syncDots(i);
        updateMainImage(el.dataset.url || '', el.dataset.alt || '');
      }
    });
  });

  // ─── Variant selector ──────────────────────
  variantBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if ((btn as HTMLButtonElement).disabled) return;

      variantBtns.forEach(b => b.classList.remove('pdp-variant-btn--active'));
      btn.classList.add('pdp-variant-btn--active');

      const el = btn as HTMLElement;
      const variantId = el.dataset.variantId || '';
      const variantPrice = el.dataset.variantPrice || '';
      const variantCompare = el.dataset.variantCompare || '';
      const variantAvailable = el.dataset.variantAvailable === 'true';
      const variantImage = el.dataset.variantImage || '';
      const variantTitle = el.dataset.variantTitle || '';

      // Update add to cart button
      const variantQtyRaw = parseInt(el.dataset.variantQty || '');
      if (addToCartBtn) {
        addToCartBtn.dataset.variantId = variantId;
        addToCartBtn.dataset.variantTitle = variantTitle;
        addToCartBtn.dataset.productPrice = variantPrice;
        addToCartBtn.dataset.variantQty = el.dataset.variantQty || '';
        // If the variant has its own image, use it for the cart line preview.
        // Otherwise keep whatever the server-rendered product image was.
        if (variantImage) addToCartBtn.dataset.productImage = variantImage;
        addToCartBtn.disabled = !variantAvailable;
        addToCartBtn.textContent = variantAvailable ? 'Add to Cart' : 'Sold Out';
      }

      // Update price display
      if (currentPriceEl) currentPriceEl.textContent = fmtPrice(parseFloat(variantPrice));
      if (comparePriceEl) {
        if (variantCompare && parseFloat(variantCompare) > parseFloat(variantPrice)) {
          comparePriceEl.textContent = fmtPrice(parseFloat(variantCompare));
          comparePriceEl.style.display = '';
        } else {
          comparePriceEl.style.display = 'none';
        }
      }

      // Update sticky bar price
      if (stickyPrice) stickyPrice.textContent = fmtPrice(parseFloat(variantPrice));

      // Update sticky header price
      if (stickyHeaderPrice) stickyHeaderPrice.textContent = fmtPrice(parseFloat(variantPrice));

      // Update selected label
      if (selectedLabel) selectedLabel.textContent = variantTitle;

      // Update stock quantity and urgency indicator
      const variantQty = parseInt(el.dataset.variantQty || '');
      if (urgencyEl && stockCountEl) {
        if (!isNaN(variantQty) && variantQty > 0 && variantQty <= 5) {
          stockCountEl.textContent = String(variantQty);
          urgencyEl.style.display = 'flex';
        } else {
          urgencyEl.style.display = 'none';
        }
      }

      // Price change animation
      if (currentPriceEl) {
        currentPriceEl.classList.add('price-changed');
        setTimeout(() => currentPriceEl.classList.remove('price-changed'), 300);
      }

      // Switch image if variant has one
      if (variantImage) {
        updateMainImage(variantImage);
        // Update thumb active state
        thumbs.forEach((t, i) => {
          const thumbUrl = (t as HTMLElement).dataset.url || '';
          if (thumbUrl === variantImage) {
            thumbs.forEach(tt => tt.classList.remove('pdp-thumb--active'));
            t.classList.add('pdp-thumb--active');
            currentImageIdx = i;
          }
        });
      }
    });
  });

  // ─── Quantity selector ──────────────────────
  qtyMinus?.addEventListener('click', () => {
    const val = parseInt(qtyInput?.value || '1');
    if (val > 1 && qtyInput) qtyInput.value = String(val - 1);
  });

  qtyPlus?.addEventListener('click', () => {
    const val = parseInt(qtyInput?.value || '1');
    if (val < 20 && qtyInput) qtyInput.value = String(val + 1);
  });

  qtyInput?.addEventListener('change', () => {
    let val = parseInt(qtyInput.value || '1');
    if (isNaN(val) || val < 1) val = 1;
    if (val > 20) val = 20;
    qtyInput.value = String(val);
  });

  // ─── Add to cart ────────────────────────────
  function handleAddToCart() {
    const variantId = addToCartBtn?.dataset.variantId;
    if (!variantId) return;

    const title = addToCartBtn.dataset.productTitle || '';
    const price = parseFloat(addToCartBtn.dataset.productPrice || '0');
    const image = addToCartBtn.dataset.productImage || '';
    const handle = addToCartBtn.dataset.productHandle || '';
    const variantTitle = addToCartBtn.dataset.variantTitle || '';
    const qty = parseInt(qtyInput?.value || '1');

    const product = { variantId, title, price, image, handle, variantTitle };
    if (typeof window.addToCart === 'function') {
      window.addToCart(product, qty);
    } else {
      // Island not hydrated yet — queue so the click isn't silently dropped.
      (window.__cartQueue = window.__cartQueue || []).push({ product, qty });
    }

    addToCartBtn.textContent = 'Added!';
    addToCartBtn.classList.add('btn--added');
    setTimeout(() => {
      addToCartBtn.textContent = 'Add to Cart';
      addToCartBtn.classList.remove('btn--added');
    }, 1500);
  }

  addToCartBtn?.addEventListener('click', handleAddToCart);

  // ─── Buy Now ─────────────────────────────────
  const buyNowBtn = document.getElementById('buy-now');
  buyNowBtn?.addEventListener('click', async () => {
    const variantId = addToCartBtn?.dataset.variantId;
    if (!variantId) return;
    const qty = parseInt(qtyInput?.value || '1');

    if (buyNowBtn instanceof HTMLButtonElement) {
      buyNowBtn.disabled = true;
      buyNowBtn.textContent = 'Preparing…';
    }

    const url = await buyNow(variantId, qty);
    if (url) {
      window.location.href = url;
    } else {
      // Variant no longer available
      if (buyNowBtn instanceof HTMLButtonElement) {
        buyNowBtn.textContent = 'Unavailable';
        setTimeout(() => { buyNowBtn.textContent = 'Buy Now'; buyNowBtn.disabled = false; }, 2000);
      }
    }
  });

  // Sticky bar add to cart
  stickyAdd?.addEventListener('click', handleAddToCart);

  // ─── Share Button ─────────────────────────
  const shareBtn = document.getElementById('pdp-share');
  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    const title = addToCartBtn?.dataset.productTitle || document.title;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch { /* User cancelled */ }
    } else {
      // Fallback: copy to clipboard
      try {
        await navigator.clipboard.writeText(url);
        const span = shareBtn.querySelector('span');
        if (span) {
          const orig = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = orig; }, 2000);
        }
      } catch { /* Clipboard failed */ }
    }
  });

  // ─── Touch swipe helper ────────────────────
  function addSwipe(el: HTMLElement, onLeft: () => void, onRight: () => void) {
    let startX = 0;
    let startY = 0;
    let tracking = false;
    el.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      tracking = true;
    }, { passive: true });
    el.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) onLeft();
        else onRight();
      }
    }, { passive: true });
  }

  // ─── Lightbox ───────────────────────────────
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  const lightboxCounter = document.getElementById('lightbox-counter');
  let lightboxIdx = 0;

  let lightboxPrevFocus: HTMLElement | null = null;

  // Optimize image URL for lightbox via CF Images (AVIF/WebP, 1400px)
  function optimizedUrl(url: string, width = 1400) {
    return cfImg(url, width);
  }

  // Calculate scrollbar width for fallback (browsers without scrollbar-gutter support)
  function getScrollbarWidth(): number {
    return window.innerWidth - document.documentElement.clientWidth;
  }

  function lockBodyScroll() {
    const scrollbarWidth = getScrollbarWidth();
    document.body.style.overflow = 'hidden';
    // Compensate for scrollbar disappearance to prevent layout shift
    if (scrollbarWidth > 0) {
      document.body.style.paddingRight = `${scrollbarWidth}px`;
    }
  }

  function unlockBodyScroll() {
    document.body.style.overflow = '';
    document.body.style.paddingRight = '';
  }

  function openLightbox(idx: number) {
    lightboxPrevFocus = document.activeElement as HTMLElement;
    lightboxIdx = idx;
    updateLightbox();
    lightbox?.setAttribute('aria-hidden', 'false');
    lockBodyScroll();
    setTimeout(() => lightboxClose?.focus(), 50);
  }

  function closeLightbox() {
    lightbox?.setAttribute('aria-hidden', 'true');
    unlockBodyScroll();
    lightboxPrevFocus?.focus();
    lightboxPrevFocus = null;
  }

  function updateLightbox() {
    if (lightboxImg) lightboxImg.src = optimizedUrl(imageUrls[lightboxIdx] || '');
    if (lightboxCounter && imageUrls.length > 1) {
      lightboxCounter.textContent = `${lightboxIdx + 1} / ${imageUrls.length}`;
    }
    if (lightboxPrev) lightboxPrev.style.display = imageUrls.length > 1 ? '' : 'none';
    if (lightboxNext) lightboxNext.style.display = imageUrls.length > 1 ? '' : 'none';
    // Preload adjacent images
    if (imageUrls.length > 1) {
      const nextIdx = (lightboxIdx + 1) % imageUrls.length;
      const img = new Image();
      img.src = optimizedUrl(imageUrls[nextIdx]);
    }
  }

  function lightboxGoNext() {
    lightboxIdx = (lightboxIdx + 1) % imageUrls.length;
    updateLightbox();
  }

  function lightboxGoPrev() {
    lightboxIdx = (lightboxIdx - 1 + imageUrls.length) % imageUrls.length;
    updateLightbox();
  }

  galleryMain?.addEventListener('click', () => { if (imageUrls.length) openLightbox(currentImageIdx); });
  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  lightboxPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    lightboxGoPrev();
  });

  lightboxNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    lightboxGoNext();
  });

  // Touch swipe on lightbox
  if (lightbox) addSwipe(lightbox, lightboxGoNext, lightboxGoPrev);

  // Keyboard navigation (clean up previous handler to avoid duplicates)
  if (_pdpKeyHandler) document.removeEventListener('keydown', _pdpKeyHandler);
  _pdpKeyHandler = (e: KeyboardEvent) => {
    if (lightbox?.getAttribute('aria-hidden') === 'false') {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') lightboxGoPrev();
      if (e.key === 'ArrowRight') lightboxGoNext();
    }
  };
  document.addEventListener('keydown', _pdpKeyHandler);

  // ─── Touch swipe on main gallery image ─────
  if (galleryMain && imageUrls.length > 1) {
    function swipeTo(idx: number) {
      currentImageIdx = idx;
      thumbs.forEach(t => t.classList.remove('pdp-thumb--active'));
      thumbs[currentImageIdx]?.classList.add('pdp-thumb--active');
      syncDots(currentImageIdx);
      updateMainImage(imageUrls[currentImageIdx]);
    }
    addSwipe(galleryMain,
      () => swipeTo((currentImageIdx + 1) % imageUrls.length),
      () => swipeTo((currentImageIdx - 1 + imageUrls.length) % imageUrls.length)
    );
  }

  // ─── Sticky mobile bar & desktop header ─────
  if (stickyBar || stickyHeader) {
    const root = document.documentElement;
    const observer = new IntersectionObserver(
      ([entry]) => {
        const isHidden = !entry.isIntersecting;
        if (stickyBar) { stickyBar.classList.toggle('is-visible', isHidden); stickyBar.inert = !isHidden; }
        if (stickyHeader) {
          stickyHeader.style.top = `${Math.max(0, document.querySelector('.nav')?.getBoundingClientRect().bottom ?? 0)}px`;
          stickyHeader.setAttribute('aria-hidden', String(!isHidden));
          stickyHeader.inert = !isHidden;
        }
        // The chat button rides above the phone bar instead of covering its button.
        const barShown = isHidden && stickyBar && !stickyBar.hidden && getComputedStyle(stickyBar).display !== 'none';
        root.style.setProperty('--bottom-bar', barShown ? `${stickyBar!.offsetHeight}px` : '0px');
      },
      { threshold: 0 }
    );
    document.addEventListener('astro:before-swap', () => { observer.disconnect(); root.style.removeProperty('--bottom-bar'); }, { once: true });
    // Watch the action this page has: the cart when it's shown, else the request form.
    const action = addToCartBtn && addToCartBtn.offsetParent ? addToCartBtn : document.getElementById('request');
    if (action) observer.observe(action);
  }

  // Sticky header add to cart
  stickyHeaderAdd?.addEventListener('click', handleAddToCart);

  // ─── Frequently Bought Together ──────────────
  const fbtAddAll = document.getElementById('fbt-add-all');
  const fbtChecks = document.querySelectorAll('.fbt-check');
  const fbtTotalPrice = document.getElementById('fbt-total-price');

  // Recalculate FBT total when checkboxes change
  function updateFbtTotal() {
    const currentPrice = parseFloat(addToCartBtn?.dataset.productPrice || '0');
    let total = currentPrice;
    fbtChecks.forEach(cb => {
      if ((cb as HTMLInputElement).checked) {
        total += parseFloat((cb as HTMLElement).dataset.price || '0');
      }
    });
    if (fbtTotalPrice) fbtTotalPrice.textContent = fmtPrice(total);
  }

  fbtChecks.forEach(cb => cb.addEventListener('change', updateFbtTotal));

  fbtAddAll?.addEventListener('click', async () => {
    // Batch every checked item + the current product into one Shopify call.
    const currency = (typeof window !== 'undefined' && window.__SHOPIFY_CURRENCY) || 'USD';
    const items: Parameters<typeof addLines>[0] = [];

    // Current product (whatever variant is currently selected)
    const currentVariantId = addToCartBtn?.dataset.variantId;
    if (currentVariantId) {
      const qty = parseInt(qtyInput?.value || '1') || 1;
      items.push({
        merchandiseId: currentVariantId,
        quantity: qty,
        productHandle: addToCartBtn?.dataset.productHandle || '',
        productTitle: addToCartBtn?.dataset.productTitle || '',
        variantTitle: addToCartBtn?.dataset.variantTitle || '',
        image: addToCartBtn?.dataset.productImage ? { url: addToCartBtn.dataset.productImage, altText: null } : null,
        price: { amount: addToCartBtn?.dataset.productPrice || '0', currencyCode: currency },
      });
    }

    fbtChecks.forEach((cb) => {
      if (!(cb as HTMLInputElement).checked) return;
      const el = cb as HTMLElement;
      const id = el.dataset.variantId || '';
      if (!id) return;
      items.push({
        merchandiseId: id,
        quantity: 1,
        productHandle: el.dataset.handle || '',
        productTitle: el.dataset.title || '',
        variantTitle: '',
        image: el.dataset.image ? { url: el.dataset.image, altText: null } : null,
        price: { amount: el.dataset.price || '0', currencyCode: currency },
      });
    });

    if (items.length === 0) return;

    (fbtAddAll as HTMLButtonElement).disabled = true;
    fbtAddAll.textContent = 'Adding…';
    await addLines(items);
    window.showCartToast?.('Items added to cart');
    window.openCart?.();
    fbtAddAll.textContent = 'All Added!';
    setTimeout(() => {
      fbtAddAll.textContent = 'Add All to Cart';
      (fbtAddAll as HTMLButtonElement).disabled = false;
    }, 2000);
  });

  // ─── Enhanced Image Zoom with lens effect ───────
  if (galleryMain && mainImg) {
    const isDesktop = window.matchMedia('(min-width: 769px)').matches;

    if (isDesktop) {
      galleryMain.addEventListener('mouseenter', () => {
        galleryMain.classList.add('is-zooming');
      });

      galleryMain.addEventListener('mousemove', (e) => {
        const rect = galleryMain.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        mainImg.style.transformOrigin = `${x}% ${y}%`;
        mainImg.style.transform = 'scale(2.5)';
        // Move the lens pseudo-element
        (galleryMain as HTMLElement).style.setProperty('--lens-x', `${e.clientX - rect.left}px`);
        (galleryMain as HTMLElement).style.setProperty('--lens-y', `${e.clientY - rect.top}px`);
      });

      galleryMain.addEventListener('mouseleave', () => {
        galleryMain.classList.remove('is-zooming');
        mainImg.style.transformOrigin = 'center';
        mainImg.style.transform = 'scale(1)';
      });
    }
  }

  // ─── Track recently viewed ──────────────────
  const pdpHandle = addToCartBtn?.dataset.productHandle;
  const pdpTitle = addToCartBtn?.dataset.productTitle;
  const pdpImage = addToCartBtn?.dataset.productImage;
  const pdpPrice = addToCartBtn?.dataset.productPrice;
  if (pdpHandle && pdpTitle) {
    recentlyViewed.add({ handle: pdpHandle, title: pdpTitle, image: pdpImage, price: pdpPrice });
  }

  // ─── Render recently viewed ─────────────────
  const recentSection = document.getElementById('recently-section');
  const recentScroll = document.getElementById('recently-scroll');

  if (recentSection && recentScroll) {
    const items = recentlyViewed.getItems().filter((i: any) => i.handle !== pdpHandle);
    if (items.length > 0) {
      recentSection.style.display = '';
      const frag = document.createDocumentFragment();
      items.slice(0, 8).forEach((item: any) => {
        const card = document.createElement('a');
        card.href = `/shop/${encodeURIComponent(item.handle)}/`;
        card.className = 'recently-card';

        const imgWrap = document.createElement('div');
        imgWrap.className = 'recently-card__image';
        if (item.image) {
          const img = document.createElement('img');
          // Optimize: 320px (2x retina for 160px card)
          img.src = item.image.includes('cdn.shopify.com') ? `${item.image}?width=320&crop=center` : item.image;
          img.alt = item.title || '';
          img.loading = 'lazy';
          imgWrap.appendChild(img);
        }
        card.appendChild(imgWrap);

        const titleEl = document.createElement('span');
        titleEl.className = 'recently-card__title';
        titleEl.textContent = item.title;
        card.appendChild(titleEl);

        if (item.price) {
          const priceEl = document.createElement('span');
          priceEl.className = 'recently-card__price';
          priceEl.textContent = fmtPrice(parseFloat(item.price));
          card.appendChild(priceEl);
        }

        frag.appendChild(card);
      });
      recentScroll.replaceChildren(frag);
    }
  }

  }); // end astro:page-load

  // ─── Special-order request ───────────────────
  // The rules are shared with the server (src/lib/special-order-request.mjs), so a shopper
  // sees the server's words before sending. A box is checked when the shopper leaves it
  // (Baymard, NN/g), never while they first type, and its error clears on the keystroke
  // that fixes it. Runs on every page load: the site moves between pages without reloading.
  document.addEventListener('astro:page-load', () => {
    const section = document.getElementById('request') as HTMLElement | null;
    const form = document.getElementById('request-form') as HTMLFormElement | null;
    if (!section || !form) return;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const openBtn = $<HTMLButtonElement>('rq-open');
    const panel = $<HTMLElement>('rq-panel');
    const card = $<HTMLElement>('rq-card');
    const title = $<HTMLElement>('pdp-request-title');
    const submit = $<HTMLButtonElement>('rq-submit');
    const submitLabel = $<HTMLElement>('rq-submit-label');
    const alertBox = $<HTMLElement>('rq-alert');
    const alertText = $<HTMLElement>('rq-alert-text');
    const reloadBtn = $<HTMLButtonElement>('rq-reload');
    const done = $<HTMLElement>('rq-done');
    const doneText = $<HTMLElement>('rq-done-text');
    const fields = { name: $<HTMLInputElement>('rq-name'), contact: $<HTMLInputElement>('rq-contact'), note: $<HTMLTextAreaElement>('rq-note') };
    type Field = keyof typeof fields;
    const reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = matchMedia('(pointer: fine)').matches;
    const OPEN_MS = 320;

    // ── Open: the button folds away and the form unfolds in its place.
    const open = (from: 'button' | 'sticky') => {
      if (section.dataset.open === 'true') {
        if (from === 'sticky') section.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'start' });
        return;
      }
      section.dataset.open = 'true';
      openBtn.setAttribute('aria-expanded', 'true');
      panel.inert = false;
      // The folded button can't be reached any more: focus never lands on something unseen.
      (openBtn.closest('.pdp-request__trigger') as HTMLElement).inert = true;
      if (from === 'sticky') section.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'start' });
      // A mouse or keyboard goes straight to typing; on a phone the keyboard waits for a tap,
      // and screen readers land on the form's heading.
      window.setTimeout(() => (finePointer ? fields.name : title).focus({ preventScroll: true }), reduceMotion() ? 0 : OPEN_MS);
    };
    openBtn.addEventListener('click', () => open('button'));
    document.querySelectorAll<HTMLAnchorElement>('[data-open-request]').forEach((a) => {
      a.addEventListener('click', (e) => { e.preventDefault(); open('sticky'); });
    });
    // Arriving at /shop/…/#request (a link from an email or the sticky bar before the script ran)
    if (location.hash === '#request') open('sticky');

    // ── Checking boxes
    const errorEl = (f: Field) => $<HTMLElement>(`rq-${f}-error`);
    const setError = (f: Field, message: string | null) => {
      const el = errorEl(f);
      if (message) {
        if (el.textContent !== message || el.hidden) { el.textContent = message; el.hidden = false; }
        fields[f].setAttribute('aria-invalid', 'true');
      } else {
        el.hidden = true;
        el.textContent = '';
        fields[f].removeAttribute('aria-invalid');
      }
    };
    const touched = new Set<Field>();
    (Object.keys(fields) as Field[]).forEach((f) => {
      fields[f].addEventListener('blur', () => {
        if (!fields[f].value.trim() && !touched.has(f)) return; // passing through an empty box isn't a mistake yet
        touched.add(f);
        setError(f, fieldError(f, fields[f].value));
      });
      fields[f].addEventListener('input', () => {
        // Only ever clears while typing: the keystroke that fixes it takes the message away.
        if (fields[f].getAttribute('aria-invalid') === 'true' && !fieldError(f, fields[f].value)) setError(f, null);
        if (!alertBox.hidden) alertBox.hidden = true;
      });
    });

    /** Brings a box into view with its label and message (not just its edge under the nav), then focuses it. */
    const focusField = (f: Field) => {
      fields[f].closest('.pdp-request__field')?.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'center' });
      fields[f].focus({ preventScroll: true });
    };
    /** Writes a message, with the store's number as a tap-to-call link. */
    const withPhoneLink = (el: HTMLElement, message: string) => {
      el.textContent = '';
      message.split(STORE_PHONE).forEach((part, i) => {
        // appendChild, not append: the worker types' Element.append (HTMLRewriter) takes only strings.
        if (i) { const a = document.createElement('a'); a.href = `tel:+1${STORE_PHONE.replace(/\D/g, '')}`; a.textContent = STORE_PHONE; el.appendChild(a); }
        el.appendChild(document.createTextNode(part));
      });
    };
    const showAlert = (message: string, code?: string) => {
      withPhoneLink(alertText, message);
      reloadBtn.hidden = code !== 'reload';
      alertBox.hidden = false;
      const r = alertBox.getBoundingClientRect();
      if (r.top < 120 || r.bottom > innerHeight - 24) alertBox.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'center' });
    };
    reloadBtn.addEventListener('click', () => location.reload());
    const count = $<HTMLElement>('rq-note-count');
    const NOTE_MAX = fields.note.maxLength;
    fields.note.addEventListener('input', () => {
      const left = NOTE_MAX - fields.note.value.length;
      count.hidden = left > 150;
      count.textContent = left === 1 ? '1 character left' : `${left} characters left`;
      count.classList.toggle('is-near', left <= 20);
    });

    // A likely slip in an email's domain (gmial.com, .con): offered, never forced.
    const suggest = $<HTMLElement>('rq-contact-suggest');
    const suggestBtn = $<HTMLButtonElement>('rq-suggest-btn');
    const offerFix = () => {
      const fix = emailSuggestion(fields.contact.value);
      suggest.hidden = !fix;
      if (fix) suggestBtn.textContent = fix;
    };
    fields.contact.addEventListener('blur', offerFix);
    fields.contact.addEventListener('input', () => { if (!suggest.hidden) offerFix(); });
    suggestBtn.addEventListener('click', () => {
      fields.contact.value = suggestBtn.textContent ?? fields.contact.value;
      suggest.hidden = true;
      setError('contact', fieldError('contact', fields.contact.value));
      fields.contact.focus();
    });
    const root = document.documentElement;
    /**
     * Whatever gets focus in the form shows whole (its label, box and message), clear of the
     * fixed nav at the top and the phone bar or keyboard at the bottom (WCAG 2.4.11). Done
     * here because browsers differ: Safari's own scroll left a tabbed-to box 14px off screen.
     */
    const keepInView = (el: HTMLElement) => {
      const box = (el.closest('.pdp-request__field') as HTMLElement | null) ?? el;
      const r = box.getBoundingClientRect();
      const viewH = window.visualViewport?.height ?? innerHeight;
      const bars = [document.querySelector('.nav'), document.getElementById('sticky-header')]
        .filter((b): b is HTMLElement => Boolean(b) && !(b as HTMLElement).hidden && getComputedStyle(b as HTMLElement).display !== 'none' && (b as HTMLElement).getAttribute('aria-hidden') !== 'true');
      const top = Math.max(0, ...bars.map((b) => b.getBoundingClientRect().bottom)) + 16;
      const bottom = viewH - 24;
      const by = r.height > bottom - top ? r.top - top : r.bottom > bottom ? r.bottom - bottom : r.top < top ? r.top - top : 0;
      if (Math.abs(by) > 1) window.scrollBy({ top: by, behavior: reduceMotion() ? 'auto' : 'smooth' });
    };
    form.addEventListener('focusin', (e) => {
      root.dataset.typing = 'true';
      const el = e.target as HTMLElement;
      // After the browser's own scroll (and the phone keyboard) has settled.
      window.setTimeout(() => { if (document.activeElement === el) keepInView(el); }, 60);
    });
    form.addEventListener('focusout', () => {
      window.setTimeout(() => { if (!form.contains(document.activeElement)) delete root.dataset.typing; }, 0);
    });
    document.addEventListener('astro:before-swap', () => { delete root.dataset.typing; }, { once: true });

    let sending = false;
    const setSending = (on: boolean) => {
      sending = on;
      // aria-disabled, not disabled: the button keeps keyboard focus while it works.
      submit.setAttribute('aria-disabled', String(on));
      if (on) submit.setAttribute('aria-busy', 'true'); else submit.removeAttribute('aria-busy');
      submitLabel.textContent = on ? 'Sending…' : 'Send request';
    };

    /** Shows one of the card's end states (sent, or just sold) in place of the form, at the
     *  form's height so nothing on the page jumps, and moves focus to its heading. */
    const finish = (endState: HTMLElement) => {
      const style = getComputedStyle(card);
      const inner = card.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
      endState.style.minHeight = `${inner}px`;
      title.hidden = true;
      form.hidden = true;
      endState.hidden = false;
      section.dataset.sent = 'true';
      endState.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
      // Nothing left to ask for: the sticky bar and header go, and the chat button settles back.
      document.querySelectorAll<HTMLElement>('#sticky-bar, #sticky-header').forEach((el) => { el.hidden = true; });
      document.documentElement.style.setProperty('--bottom-bar', '0px');
    };

    /** It came back in stock since this page was built: the cart takes over, right here. */
    const backInStock = () => {
      const buy = document.querySelector<HTMLElement>('.pdp-buy');
      const add = document.getElementById('add-to-cart') as HTMLButtonElement | null;
      if (!buy || !add) return false;
      buy.hidden = false;
      document.querySelector<HTMLElement>('.pdp-delivery')?.removeAttribute('hidden');
      add.disabled = false;
      add.textContent = 'Add to Cart';
      section.hidden = true;
      document.querySelectorAll<HTMLElement>('#sticky-bar, #sticky-header').forEach((el) => { el.hidden = true; });
      const line = document.querySelector('.pdp-where__line');
      if (line) line.textContent = 'Back in stock';
      const detail = document.querySelector('.pdp-where__detail');
      if (detail) detail.textContent = 'Good news: it’s back. You can buy it now.';
      add.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'center' });
      add.focus({ preventScroll: true });
      return true;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      alertBox.hidden = true;
      const values = { name: fields.name.value, contact: fields.contact.value, note: fields.note.value };
      const website = (form.elements.namedItem('website') as HTMLInputElement | null)?.value ?? '';
      // Every box at once: each shows its own message, and focus goes to the first to fix.
      const wrong = (Object.keys(fields) as Field[]).filter((f) => { touched.add(f); const m = fieldError(f, values[f]); setError(f, m); return Boolean(m); });
      if (wrong.length) { focusField(wrong[0]); return; }

      setSending(true);
      try {
        const res = await fetch('/api/special-order-request/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...values, website, handle: form.dataset.handle }),
        });
        const body = (await res.json().catch(() => ({}))) as { error?: string; field?: string; code?: string; replyBy?: string };
        if (!res.ok) {
          if (body.code === 'back-in-stock' && backInStock()) return;
          if (body.code === 'sold') return finish($<HTMLElement>('rq-sold'));
          if (body.field && body.field in fields) { setError(body.field as Field, body.error ?? null); focusField(body.field as Field); }
          else showAlert(body.error || `We couldn’t send your request just now. Try again in a minute, or call us at ${STORE_PHONE}.`, body.code);
          return;
        }
        // Sent: says how and when we'll answer, what happens after, and that a copy is coming.
        const by = body.replyBy ? `by ${body.replyBy}` : 'by the next business day';
        const { email, phone } = splitContact(values.contact);
        const how = document.createElement('span');
        how.className = 'nowrap';
        how.textContent = (email ?? phone) as string;
        doneText.textContent = `We’ll ${email ? 'email' : 'call'} you at `;
        doneText.appendChild(how);
        doneText.appendChild(document.createTextNode(` ${by} with the price and arrival date.${email ? ' A copy of your request is on its way to your inbox.' : ''}`));
        const step = document.getElementById('rq-step-reply');
        if (step) step.textContent = `We ${email ? 'email' : 'call'} you ${by}.`;
        finish(done);
      } catch {
        // No connection: the browser's own words ("Failed to fetch") never reach the shopper.
        showAlert(`We couldn’t reach the store. Check your connection and try again, or call us at ${STORE_PHONE}.`);
      } finally {
        setSending(false);
      }
    });
  });
</script>
