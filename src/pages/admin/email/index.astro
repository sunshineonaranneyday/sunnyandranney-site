---
export const prerender = false;

import EmailApp from '@/components/email/EmailApp';
import type { AppProps } from '@/components/email/model';
import '@/components/email/email.css';
import AdminBase from '@/layouts/AdminBase.astro';
import { STORE_TIERS, USUAL_PERCENT, sendLabel, usualEnds } from '@/lib/sunny-side/special.mjs';
import { eventsFrom } from '@/lib/sunny-side/event-store.mjs';
import { pastWeeks, setKit, weekToWorkOn } from '@/lib/sunny-side/week-store.mjs';
import { IMPACT_PAGE, impactFromPage } from '@/lib/sunny-side/impact.mjs';
import { broadcastUrl, kitClient, statusOf, subscriberCount, usualTime } from '@/lib/sunny-side/kit.mjs';
import { listRevealedKids, listUpcomingReveals } from '@/lib/sunny-side/kids.mjs';
import { blankParts } from '@/lib/sunny-side/parts.mjs';
import { listPhotos, photosByIds } from '@/lib/sunny-side/photo-store.mjs';
import { testPeople } from '@/lib/sunny-side/testers.mjs';
import { listPeople, recentTests } from '@/lib/sunny-side/test-store.mjs';
import { listReports } from '@/lib/sunny-side/layout-store.mjs';
import { localDate } from '@/lib/time-clock/hours.mjs';

const admin = Astro.locals.admin;
if (admin?.role !== 'manager' && admin?.role !== 'email') return new Response('Not authorized', { status: 403 });

// One email at a time: this week's until it has gone out, then next week's (weekToWorkOn). This
// week's stays until its Saturday, so one that missed its Tuesday can still go out (sendDays). The
// ones already sent are read-only, at /admin/email/sent/. An old address naming a week comes here.
if (Astro.url.searchParams.has('send')) return Astro.redirect('/admin/email/', 302);
const db = Astro.locals.runtime.env.DB;
const today = localDate(new Date().toISOString());
const { send, week: record } = await weekToWorkOn(db, today);

/** The charity's numbers for the preview's impact strip, cached an hour; the Kit draft reads them fresh. */
async function impactNow() {
  try {
    const res = await fetch(IMPACT_PAGE, { headers: { 'User-Agent': 'sunny-and-ranney-admin' }, signal: AbortSignal.timeout(4000), cf: { cacheTtl: 3600 } } as RequestInit);
    return res.ok ? impactFromPage(await res.text()) : null;
  } catch {
    return null;
  }
}

const env = Astro.locals.runtime.env;
const kit = env.KIT_API_KEY ? kitClient({ key: env.KIT_API_KEY, base: env.KIT_API_BASE || undefined }) : null;
/** A Kit answer for the page, or null if Kit is slow or says no: the page still works without it, and the log says why. */
async function fromKit<T>(what: string, ask: () => Promise<T>): Promise<T | null> {
  if (!kit) return null;
  try {
    return await Promise.race([ask(), new Promise<null>((done) => setTimeout(() => (console.error(`Kit ${what}: no answer in 4 seconds`), done(null)), 4000))]);
  } catch (err) {
    console.error(`Kit ${what}:`, err instanceof Error ? err.message : err);
    return null;
  }
}
async function kidsNow() {
  try {
    return await listRevealedKids(env.SOARD_DB, today);
  } catch {
    return [];
  }
}

/** The charity's reveals still ahead, for the story spot; none if its database or site doesn't answer. */
async function revealsNow() {
  try {
    return await listUpcomingReveals(env.SOARD_DB, today);
  } catch {
    return [];
  }
}

const [past, events, testList, library, impact, kids, reveals, usual, subscribers] = await Promise.all([
  pastWeeks(db, send, 12),
  eventsFrom(db, today),
  listPeople(db),
  listPhotos(db, 80),
  impactNow(),
  kidsNow(),
  revealsNow(),
  fromKit('usual time', () => usualTime(kit!)),
  fromKit('subscriber count', () => subscriberCount(kit!)),
]);
const parts = record?.parts ?? blankParts();
// The library, plus any older photo this email still uses
const using = [parts.hero, ...parts.story.photos].filter((id) => id && !library.some((p) => p.id === id));
// Problems in the email's own layout, which only the owner is shown (layout-store.mjs)
const [older, tests, layoutReports] = await Promise.all([photosByIds(db, using), recentTests(db, send), admin.owner ? listReports(db) : []]);
const photos = [...library, ...older];
// Where the week's send stands in Kit now: scheduled, sending or sent. One deleted in Kit's own app
// counts as none, so the email unlocks; if Kit doesn't answer, it stays as it was noted.
const kitStatus = record?.kit ? await fromKit('send status', () => statusOf(kit!, record.kit!.id)) : null;
if (record?.kit && kitStatus?.status === 'gone') {
  await setKit(db, { send, id: null });
  record.kit = null;
}
const kitSend = record?.kit ? { ...record.kit, url: broadcastUrl(record.kit.id), status: kitStatus?.status ?? 'scheduled' } : null;
// What each ready-made sale opens with: the store's last of its kind, else the usual (special.mjs)
const lastOf = (kind: string) => past.find((r) => r.special?.kind === kind)?.special ?? null;
type Tier = { spend: number | null; percent: number | null };
const lastTiers = (lastOf('tiers')?.tiers as Tier[] | undefined)?.filter((t): t is { spend: number; percent: number } => t.spend !== null && t.percent !== null);
// Each ready-made sale starts filled in: from the last one saved here, else the store's own (special.mjs)
const presets = { percent: lastOf('percent')?.percent ?? USUAL_PERCENT, tiers: lastTiers?.length ? lastTiers : STORE_TIERS.map((t) => ({ ...t })), ends: usualEnds(send) };

// The shared rules are plain JavaScript; the page's types say what they return
const props = {
  send,
  label: sendLabel(send),
  today,
  record: record ? { special: record.special, wall: record.wall, updatedAt: record.updatedAt, updatedBy: record.updatedBy } : null,
  presets,
  events,
  // Who checks each email: the store's list, kept in D1, with whoever is signed in first
  test: { people: testPeople(testList, admin.email), me: admin.email.toLowerCase() },
  parts,
  photos,
  kitSend,
  tests,
  kids,
  reveals,
  usualTime: usual,
  subscribers: Number.isFinite(subscribers) ? subscribers : null,
  impact,
  local: import.meta.env.DEV,
  owner: Boolean(admin.owner),
  layoutReports,
} as unknown as AppProps;
// The page's JSON can't close its own script tag.
const data = JSON.stringify(props).replace(/</g, '\\u003c');
---

<AdminBase title="Weekly email">
  <div id="email-root"><EmailApp {...props} /></div>
  <script type="application/json" id="email-data" set:html={data} />
</AdminBase>

<script>
  // Imports keep this script bundled: the admin's Content-Security-Policy blocks inline scripts.
  import { mountEmail } from '@/components/email/mount';

  mountEmail();
</script>
