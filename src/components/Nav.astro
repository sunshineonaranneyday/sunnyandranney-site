    box-shadow: 0 16px 40px rgba(44, 44, 44, 0.16), 0 2px 8px rgba(44, 44, 44, 0.06);
    padding: 6px 0;
    max-height: calc(100vh - var(--ss-top, 80px) - 24px);
    max-height: calc(100dvh - var(--ss-top, 80px) - 24px);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s var(--ease-out), transform 0.15s var(--ease-out), visibility 0s linear 0.15s;
  }
  .ss-panel[data-open="true"] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.15s var(--ease-out), transform 0.15s var(--ease-out), visibility 0s;
  }

