<script>
  // ═══════════════════════════════════════════════════════════════
  //  Nav script — View Transitions safe
  //  Uses AbortController so every listener, observer, and timer
  //  is torn down cleanly before re-init on astro:after-swap.
  // ═══════════════════════════════════════════════════════════════

  // ─── Module-level (persists across navigations) ─────────────

  import { mountSearch } from '@/lib/search/ui';
  import { warmSearchIndex } from '@/lib/search/client';

  // ─── Pure helpers (query fresh DOM each call) ───────────────

  function updateActiveTab() {
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    const search = window.location.search;
    const links = document.querySelectorAll('.nav__cat-link');

    links.forEach((link) => {
      const href = link.getAttribute('href') || '';
      const [linkPath, linkSearch] = href.split('?');
      const normalizedLinkPath = linkPath.replace(/\/$/, '') || '/';

      let isActive = false;
      if (linkSearch) {
        isActive = normalizedLinkPath === path && search.includes(linkSearch);
      } else {
        isActive = normalizedLinkPath === path && !search;
      }

      link.classList.toggle('nav__cat-link--active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function setupCatIndicator() {
    const indicator = document.getElementById('cat-indicator');
    const container = document.querySelector<HTMLElement>('.nav__categories-inner');
    const catLinks = document.querySelectorAll<HTMLElement>('.nav__cat-link');
    if (!indicator || !container || !catLinks.length) return;

    function moveToLink(link: HTMLElement) {
      const containerRect = container!.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      // getBoundingClientRect already accounts for scroll position,
      // so no need to add scrollLeft — that would double-count
      const isMobile = window.innerWidth < 768;
      const inset = isMobile ? 4 : 0;
      indicator!.style.left = `${linkRect.left - containerRect.left + inset}px`;
      indicator!.style.width = `${linkRect.width - inset * 2}px`;
      indicator!.style.opacity = '1';
    }

    function moveToActive() {
      const active = document.querySelector<HTMLElement>('.nav__cat-link--active');
      if (active) {
        moveToLink(active);
      } else {
        indicator!.style.opacity = '0';
      }
    }

    catLinks.forEach((link) => {
      link.addEventListener('click', () => moveToLink(link));
    });

    moveToActive();
  }

  function scrollActiveTabIntoView() {
    const activeLink = document.querySelector('.nav__cat-link--active') as HTMLElement;
    if (!activeLink) return;
    const container = activeLink.closest('.nav__categories') as HTMLElement;
    if (!container) return;
    const inner = container.querySelector('.nav__categories-inner') as HTMLElement;
    if (!inner) return;

    const innerRect = inner.getBoundingClientRect();
    const linkRect = activeLink.getBoundingClientRect();
    const linkOffsetInInner = linkRect.left - innerRect.left + container.scrollLeft;
    const scrollLeft = linkOffsetInInner - (container.clientWidth / 2) + (linkRect.width / 2);
    container.scrollTo({ left: Math.max(0, scrollLeft), behavior: 'smooth' });

    setTimeout(() => setupCatIndicator(), 350);
  }

  // ─── Per-navigation init ────────────────────────────────────
  //  Re-queries all DOM refs, attaches listeners via AbortController
  //  signal so everything is auto-cleaned on the next navigation.

  let _ac: AbortController | null = null;

  function init() {
    // Tear down previous lifecycle
    _ac?.abort();
    _ac = new AbortController();
    const { signal } = _ac;

    // ── Fresh DOM refs ──────────────────────────
    const nav = document.getElementById('main-nav');
    const mobileSearch = nav?.querySelector('.nav__mobile-topbar') as HTMLElement | null;
    const searchToggle = document.getElementById('mobile-search-toggle');
    const mobileSearchInput = document.getElementById('mobile-topbar-search') as HTMLInputElement | null;
    const searchInput = document.getElementById('nav-search-input') as HTMLInputElement | null;

    // ── Nav height → CSS variable (debounced to avoid CLS) ───────────────
    if (nav) {
      let lastH = 0;
      const syncHeight = () => {
        const h = Math.round(nav.getBoundingClientRect().height);
        if (h === lastH) return; // skip no-change updates
        lastH = h;
        document.documentElement.style.setProperty('--nav-height', `${h}px`);
      };
      const ro = new ResizeObserver(syncHeight);
      ro.observe(nav);
      syncHeight();
      signal.addEventListener('abort', () => ro.disconnect());

      // Pre-swap: toggle shop-active so height is correct before new content paints
      document.addEventListener('astro:before-swap', (e) => {
        const going = new URL((e as any).to).pathname;
        nav.classList.toggle('nav--shop-active', going.startsWith('/shop'));
      }, { signal });
    }

    // ── Scroll behavior ─────────────────────────
    let lastScrollY = 0;
    let scrollTicking = false;

    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        scrollTicking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          nav?.classList.toggle('nav--scrolled', y > 20);

          if (mobileSearch?.classList.contains('is-forced-open') && y > 60 && y > lastScrollY) {
            mobileSearch.classList.remove('is-forced-open');
            mobileSearch.classList.add('is-hidden');
          }
          lastScrollY = y;
          scrollTicking = false;
        });
      }
    }, { passive: true, signal });

    // ── Search ──────────────────────────────────
    // On a results page the box holds the search, so it can be changed (Baymard); elsewhere it's empty.
    const here = new URL(window.location.href);
    const searched = here.pathname.replace(/\/$/, '') === '/shop' ? (here.searchParams.get('q') ?? '') : '';
    for (const input of [searchInput, mobileSearchInput]) {
      if (input && document.activeElement !== input) input.value = searched;
    }
    const mainRow = nav?.querySelector('.nav__main') as HTMLElement | null;
    const desktopForm = document.getElementById('nav-search-form') as HTMLFormElement | null;
    const mobileForm = document.getElementById('mobile-search-form') as HTMLFormElement | null;
    if (desktopForm && searchInput) {
      mountSearch({
        form: desktopForm,
        input: searchInput,
        panel: document.getElementById('nav-search-panel')!,
        list: document.getElementById('search-suggest')!,
        note: document.getElementById('nav-search-note')!,
        status: document.getElementById('nav-search-status')!,
        clear: document.getElementById('nav-search-clear') as HTMLButtonElement | null,
        onOpen: () => {
          const bar = desktopForm.getBoundingClientRect();
          document.documentElement.style.setProperty('--ss-top', `${Math.round(bar.bottom + 8)}px`);
          if (mainRow) document.documentElement.style.setProperty('--ss-scrim-top', `${Math.round(mainRow.getBoundingClientRect().bottom)}px`);
          nav?.classList.add('nav--searching');
        },
        onClose: () => nav?.classList.remove('nav--searching'),
      }, signal);
    }
    let mobileBox: { close: () => void } | null = null;
    if (mobileForm && mobileSearchInput) {
      mobileBox = mountSearch({
        form: mobileForm,
        input: mobileSearchInput,
        panel: document.getElementById('mobile-search-panel')!,
        list: document.getElementById('mobile-search-suggest')!,
        note: document.getElementById('mobile-search-note')!,
        status: document.getElementById('mobile-search-status')!,
        clear: document.getElementById('mobile-search-clear') as HTMLButtonElement | null,
        compact: true,
        onOpen: () => {
          const bottom = (mobileSearch?.querySelector('.nav__mobile-topbar-inner') as HTMLElement | null)?.getBoundingClientRect().bottom ?? 116;
          document.documentElement.style.setProperty('--ss-sheet-top', `${Math.round(bottom + 6)}px`);
          document.documentElement.classList.add('ss-lock');
          nav?.classList.add('nav--searching');
        },
        onClose: () => {
          document.documentElement.classList.remove('ss-lock');
          nav?.classList.remove('nav--searching');
        },
      }, signal);
    }
    document.getElementById('mobile-search-cancel')?.addEventListener('click', () => {
      mobileBox?.close();
      mobileSearchInput?.blur();
      if (mobileSearchInput) {
        // What the page shows now: a results page can clear its search without a new page.
        const now = new URL(window.location.href);
        mobileSearchInput.value = now.pathname.replace(/\/$/, '') === '/shop' ? (now.searchParams.get('q') ?? '') : '';
        const x = document.getElementById('mobile-search-clear');
        if (x) x.hidden = !mobileSearchInput.value;
      }
    }, { signal });

    // ── Mobile search toggle ────────────────────
    searchToggle?.addEventListener('pointerenter', warmSearchIndex, { signal, once: true });
    searchToggle?.addEventListener('click', () => {
      if (!mobileSearch) return;
      const isOpen = mobileSearch.classList.contains('is-forced-open');
      if (isOpen) {
        mobileBox?.close();
        mobileSearch.classList.remove('is-forced-open');
        mobileSearch.classList.add('is-hidden');
      } else {
        mobileSearch.classList.remove('is-hidden');
        mobileSearch.classList.add('is-forced-open');
        // In the tap itself, so a phone opens its keyboard (it won't for a focus a moment later).
        mobileSearchInput?.focus({ preventScroll: true });
      }
    }, { signal });

    mobileSearchInput?.addEventListener('blur', () => {
      setTimeout(() => {
        // Not while its suggestions are open: the keyboard was put away to scroll them.
        if (mobileSearch && window.scrollY > 60 && !nav?.classList.contains('nav--searching')) {
          mobileSearch.classList.remove('is-forced-open');
        }
      }, 300);
    }, { signal });

    // ── Cart buttons ────────────────────────────
    document.getElementById('cart-trigger')?.addEventListener('click', () => window.openCart?.(), { signal });
    document.getElementById('mobile-cart-trigger')?.addEventListener('click', () => window.openCart?.(), { signal });

    // ── Cart badge: subscribe directly to the store (single source of truth) ──
    // Until the store confirms a real cart (snap.hasLoaded), defer to whatever
    // the inline pre-paint script wrote from the sr_cart_n cookie — overwriting
    // it with the empty initial snapshot would cause a flash-of-zero.
    const headerCount = document.getElementById('cart-count');
    const mobileCount = document.getElementById('mobile-cart-count');
    if (headerCount || mobileCount) {
      import('@/lib/cart').then(({ subscribe }) => {
        const unsub = subscribe((snap) => {
          if (!snap.hasLoaded) return;
          const n = snap.totalQuantity;
          [headerCount, mobileCount].forEach((el) => {
            if (!el) return;
            el.textContent = String(n);
            el.style.display = n > 0 ? 'flex' : 'none';
          });
        });
        signal.addEventListener('abort', unsub);
      });
    }

    // ── Active tab + indicator + scroll-into-view ──
    updateActiveTab();
    setupCatIndicator();
    requestAnimationFrame(scrollActiveTabIntoView);
  }

  // ─── Boot ───────────────────────────────────────────────────
  init();
  document.addEventListener('astro:after-swap', init);

</script>
