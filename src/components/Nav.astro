---
import { getCollectionsStatic } from '@/lib/settings';

const currentPath = Astro.url.pathname;

const collectionSettings = await getCollectionsStatic();
const enabledCollectionHandles = (collectionSettings ?? [])
  .filter(c => c.enabled)
  .map(c => c.handle);

// Fetch subcategory taxonomy at build time — zero client-side API calls
const roomCollections = [
  { handle: 'living', label: 'Living' },
  { handle: 'dining', label: 'Dining' },
  { handle: 'bedroom', label: 'Bedroom' },
  { handle: 'art-mirrors', label: 'Art & Mirrors' },
  { handle: 'rugs-collection', label: 'Rugs' },
  { handle: 'outdoor', label: 'Outdoor' },
];
---

<header class:list={['nav', { 'nav--shop-active': currentPath.startsWith('/shop') }]} id="main-nav" transition:persist="main-nav" transition:animate="none">
  <!-- Mobile header: logo + cart -->
  <div class="nav__mobile-header">
    <a href="/" class="nav__logo" aria-label="Sunny & Ranney Home">
      <img
        src="https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ/logo-tagline-light-bg/w=96,h=38,fit=scale-down,format=auto"
        srcset="https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ/logo-tagline-light-bg/w=96,h=38,fit=scale-down,format=auto 1x, https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ/logo-tagline-light-bg/w=192,h=76,fit=scale-down,format=auto 2x"
        alt="Sunny & Ranney"
        class="nav__logo-img"
        width="96"
        height="38"
        decoding="async"
      />
    </a>
    <div class="nav__mobile-actions">
      <div class="nav__split-pill nav__split-pill--mobile">
        <a href="/about/" class:list={['nav__split-pill__seg nav__split-pill__seg--mission', { 'nav__split-pill__seg--active': currentPath === '/about' || currentPath === '/about/' }]}>
          Mission
          <img src="https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ/soard-favicon/w=40,h=40,fit=cover,q=80,format=auto" alt="" class="nav__mission-pig" width="20" height="20" loading="lazy" aria-hidden="true" />
        </a>
      </div>
      <button class="nav__icon-btn nav__search-toggle" aria-label="Search products" id="mobile-search-toggle">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      <button class="nav__icon-btn nav__cart" aria-label="Shopping cart" id="mobile-cart-trigger">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <span class="nav__cart-count" id="mobile-cart-count" style="display:none;">0</span>
      </button>
    </div>
  </div>

  <!-- Mobile search bar: a form, so searching works before (and without) the script -->
  <div class="nav__mobile-topbar">
    <form class="nav__mobile-search-wrap" id="mobile-search-form" role="search" action="/shop/" method="get">
      <div class="nav__mobile-topbar-inner">
        <svg class="nav__mobile-topbar-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <label for="mobile-topbar-search" class="sr-only">Search the shop</label>
        <input
          type="search"
          name="q"
          id="mobile-topbar-search"
          placeholder="Search sofas, chairs, tables, rugs…"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          maxlength="120"
        />
        <button type="button" class="nav__search-clear" id="mobile-search-clear" aria-label="Clear search" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
        </button>
      </div>
      <button type="button" class="nav__search-cancel" id="mobile-search-cancel">Cancel</button>
      <div class="ss-panel ss-panel--sheet" id="mobile-search-panel" data-open="false">
        <p class="ss-note" id="mobile-search-note" hidden></p>
        <div class="ss-list" id="mobile-search-suggest" aria-label="Search suggestions"></div>
      </div>
      <div class="sr-only" id="mobile-search-status" role="status" aria-live="polite" aria-atomic="true"></div>
    </form>
  </div>

  <!-- Desktop nav row -->
  <div class="nav__main">
    <div class="container nav__main-inner">
      <a href="/" class="nav__logo" aria-label="Sunny & Ranney Home">
        <img
          src="https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ/logo-tagline-light-bg/w=130,h=52,fit=scale-down,format=auto"
          srcset="https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ/logo-tagline-light-bg/w=130,h=52,fit=scale-down,format=auto 1x, https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ/logo-tagline-light-bg/w=260,h=104,fit=scale-down,format=auto 2x"
          alt="Sunny & Ranney"
          class="nav__logo-img"
          width="130"
          height="52"
          decoding="async"
        />
      </a>

      <!-- Search: a form, so searching works before (and without) the script -->
      <form class="nav__search" id="nav-search-form" role="search" action="/shop/" method="get">
        <div class="nav__search-bar" id="nav-search-bar">
          <label for="nav-search-input" class="sr-only">Search the shop</label>
          <input
            type="search"
            name="q"
            id="nav-search-input"
            placeholder="Search sofas, chairs, tables, rugs…"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            maxlength="120"
          />
          <button type="button" class="nav__search-clear" id="nav-search-clear" aria-label="Clear search" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
          </button>
          <button type="submit" class="nav__search-submit" id="nav-search-submit" aria-label="Search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
        </div>
        <div class="ss-panel" id="nav-search-panel" data-open="false">
          <p class="ss-note" id="nav-search-note" hidden></p>
          <div class="ss-list" id="search-suggest" aria-label="Search suggestions"></div>
        </div>
        <div class="sr-only" id="nav-search-status" role="status" aria-live="polite" aria-atomic="true"></div>
      </form>

      <div class="nav__actions">
        <div class="nav__split-pill">
          <a href="/about/" data-astro-prefetch class:list={['nav__split-pill__seg nav__split-pill__seg--mission', { 'nav__split-pill__seg--active': currentPath === '/about' || currentPath === '/about/' }]}>
            Mission
            <img src="https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ/soard-favicon/w=40,h=40,fit=cover,q=80,format=auto" alt="" class="nav__mission-pig" width="20" height="20" loading="lazy" aria-hidden="true" />
          </a>
        </div>
        <button class="nav__icon-btn nav__cart" aria-label="Shopping cart" id="cart-trigger">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
          <span class="nav__cart-count" id="cart-count" style="display:none;">0</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Category bar -->
  <nav class="nav__categories" aria-label="Product categories">
    <div class="container nav__categories-inner">
      <span class="nav__cat-indicator" id="cat-indicator" aria-hidden="true"></span>
      <a href="/shop/" data-astro-prefetch="hover" class:list={['nav__cat-link', { 'nav__cat-link--active': currentPath === '/shop' || currentPath === '/shop/' }]}>
        All
      </a>
      <a href="/shop/?collection=new-arrivals" data-astro-prefetch="hover" class="nav__cat-link nav__cat-link--new">
        New
      </a>
      {roomCollections.map(col => (
        <a href={`/shop/?collection=${col.handle}`} data-astro-prefetch="hover" class="nav__cat-link">
          {col.label}
        </a>
      ))}
      <a href="/shop/?sale=true" data-astro-prefetch="hover" class="nav__cat-link nav__cat-link--sale">Sale</a>
    </div>
  </nav>

  <!-- Dims the page while the search panel is open (desktop) -->
  <div class="nav__scrim" aria-hidden="true"></div>
</header>

<style>
  /* ─── Screen-reader only ────────────────── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── Main Nav ─────────────────────────── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-cream);
  }

  /* Composited shadow via pseudo-element with opacity transition */
  .nav::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: 0 4px 12px rgba(44, 44, 44, 0.08), 0 1px 3px rgba(44, 44, 44, 0.04);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: -1;
  }

  .nav--scrolled::after {
    opacity: 1;
  }

  .nav--scrolled .nav__categories {
    box-shadow: none;
  }

  .nav--scrolled .nav__mobile-header {
    border-bottom-color: transparent;
  }

  /* ─── Mobile Header (logo + cart) ──────── */
  .nav__mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    height: 60px;
    border-bottom: 1px solid var(--color-cream-dark);
  }

  .nav__mobile-header .nav__logo-img {
    height: 38px;
    width: auto;
  }

  .nav__mobile-actions {
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* 44px minimum touch target for mobile icons */
  .nav__mobile-header .nav__cart,
  .nav__mobile-header .nav__search-toggle {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav__search-toggle {
    color: var(--color-charcoal);
    transition: color 0.2s;
  }
  .nav__search-toggle:hover { color: var(--color-gold); }

  @media (min-width: 768px) {
    .nav__mobile-header { display: none; }
  }

  /* ─── Mobile Search Bar ──────────────────── */
  .nav__mobile-topbar {
    display: block;
    background: var(--color-cream);
    transition: opacity 0.25s ease;
    /* Hidden by default — revealed when user taps search icon */
    max-height: 0;
    padding: 0 12px;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Hide search (scroll down or default) */
  .nav__mobile-topbar.is-hidden {
    max-height: 0;
    padding: 0 12px;
    opacity: 0;
    pointer-events: none;
  }

  /* Show when user taps search icon */
  .nav__mobile-topbar.is-forced-open {
    max-height: 60px;
    padding: 6px 12px;
    opacity: 1;
    pointer-events: auto;
  }

  .nav__mobile-search-wrap {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav__mobile-topbar-inner {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    background: var(--color-warm-white);
    border: 1.5px solid var(--color-cream-dark);
    border-radius: 8px;
    padding: 0 0 0 14px;
    height: 44px;
    gap: 8px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .nav__mobile-topbar-inner:focus-within {
    border-color: var(--color-charcoal);
    box-shadow: 0 0 0 4px var(--color-gold-soft);
  }

  .nav__mobile-topbar-icon {
    color: var(--color-stone);
    flex-shrink: 0;
  }

  .nav__mobile-topbar-inner input {
    flex: 1;
    min-width: 0;
    height: 100%;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: 1rem; /* ≥16px prevents iOS Safari auto-zoom on focus */
    color: var(--color-charcoal);
    padding: 0;
  }

  .nav__mobile-topbar-inner input::placeholder {
    color: var(--color-stone);
  }

  /* The browser's own clear button is replaced by one big enough to tap (44px) */
  .nav__search-bar input::-webkit-search-cancel-button,
  .nav__mobile-topbar-inner input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .nav__search-clear {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-stone);
    cursor: pointer;
    border-radius: 8px;
  }
  .nav__search-clear[hidden] { display: none; }
  .nav__search-clear:hover { color: var(--color-charcoal); }
  .nav__search-clear:focus-visible { outline: 2px solid var(--color-charcoal); outline-offset: -6px; }

  /* Cancel: shown while the search sheet is open, the way a phone's own search works */
  .nav__search-cancel {
    display: none;
    flex-shrink: 0;
    min-height: 44px;
    padding: 0 6px 0 8px;
    border: none;
    background: none;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-link);
    cursor: pointer;
  }
  .nav--searching .nav__search-cancel { display: inline-flex; align-items: center; }
  .nav__search-cancel:focus-visible { outline: 2px solid var(--color-charcoal); outline-offset: 2px; border-radius: 4px; }

  @media (min-width: 768px) {
    .nav__mobile-topbar { display: none; }
  }

  /* ─── Desktop Nav Row ───────────────────── */
  .nav__main {
    border-bottom: 1px solid var(--color-cream-dark);
    display: none;
  }

  @media (min-width: 768px) {
    .nav__main { display: block; }
  }

  .nav__main-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 1.5rem;
  }

  .nav__logo-img {
    height: 44px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
    aspect-ratio: 5 / 2;
  }

  @media (min-width: 768px) {
    .nav__main { border-bottom: none; }
    .nav__main-inner { height: 72px; }
    .nav__main-inner > .nav__logo { flex: 1; }
    .nav__main-inner > .nav__actions { flex: 1; justify-content: flex-end; }
    .nav__logo-img { height: 52px; }
  }

  /* ─── Search (desktop) ─────────────────── */
  .nav__search {
    flex: 1;
    max-width: 480px;
    position: relative;
    margin: 0;
  }

  .nav__search-bar {
    display: flex;
    align-items: center;
    background: var(--color-cream);
    border: 1.5px solid var(--color-cream-dark);
    border-radius: 8px;
    padding: 0 0 0 0.85rem;
    transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
  }

  .nav__search-bar:hover { border-color: #e2dbd0; }

  .nav__search-bar:focus-within {
    background: var(--color-warm-white);
    border-color: var(--color-charcoal);
    box-shadow: 0 0 0 4px var(--color-gold-soft);
  }

  /* The box around the field shows focus (the site's ring: charcoal edge, soft gold glow), so the field doesn't draw a second one inside it */
  .nav__search-bar input:focus-visible,
  .nav__mobile-topbar-inner input:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .nav__search-bar input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-charcoal);
    padding: 0.55rem 0.25rem;
  }

  .nav__search-bar input::placeholder { color: var(--color-stone); }

  .nav__search-bar .nav__search-clear { width: 36px; height: 36px; }

  .nav__search-submit {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-slate);
    border: none;
    cursor: pointer;
    transition: color 0.2s;
    flex-shrink: 0;
    border-radius: 0 6px 6px 0;
  }

  .nav__search-submit:hover { color: var(--color-charcoal); }
  .nav__search-submit:focus-visible { outline: 2px solid var(--color-charcoal); outline-offset: -4px; }

  /* The page behind the open search panel dims, so the panel reads as the thing to look at */
  .nav__scrim {
    display: none;
  }
  @media (min-width: 768px) {
    .nav__scrim {
      display: block;
      position: fixed;
      inset: var(--ss-scrim-top, var(--nav-height, 120px)) 0 0 0;
      background: rgba(44, 44, 44, 0.24);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.18s ease-out, visibility 0s linear 0.18s;
      z-index: 1; /* over the category row, under the panel (60) */
    }
    .nav--searching .nav__scrim {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.18s ease-out, visibility 0s;
    }
  }

  /* ─── Split Pill (Mission + Golf) ─────────────── */
  .nav__split-pill {
    display: inline-flex;
    border-radius: 8px;
    overflow: hidden;
    border: 1.5px solid var(--color-charcoal, #373A36);
  }

  .nav__split-pill__seg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    padding: 0.75rem 0.9rem;
    min-height: 44px;
    transition: background 0.4s, color 0.4s;
  }

  .nav__split-pill__seg--mission {
    color: var(--color-charcoal, #373A36);
    background: transparent;
  }

  .nav__split-pill__seg--mission:hover {
    background: rgba(55, 58, 54, 0.08);
    color: var(--color-charcoal);
  }

  .nav__split-pill__seg--active.nav__split-pill__seg--mission {
    background: transparent;
    color: var(--color-charcoal, #373A36);
  }

  .nav__mission-pig {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .nav__split-pill__seg:hover .nav__mission-pig {
    opacity: 0.8;
  }

  @media (min-width: 768px) {
    .nav__split-pill__seg {
      font-size: 0.78rem;
      padding: 0.4rem 1.1rem;
    }
  }

  /* ─── Actions ──────────────────────────── */
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .nav__icon-btn {
    padding: 0.5rem;
    min-width: 48px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-charcoal);
    transition: color 0.3s;
    position: relative;
  }
  .nav__icon-btn:hover { color: var(--color-gold); }

  .nav__cart { position: relative; padding: 0.5rem; min-width: 48px; min-height: 48px; display: flex; align-items: center; justify-content: center; color: var(--color-charcoal); transition: color 0.3s; }
  .nav__cart:hover { color: var(--color-gold); }

  .nav__cart-count {
    position: absolute;
    top: 0;
    right: -2px;
    width: 18px;
    height: 18px;
    background: var(--color-gold);
    color: var(--color-charcoal);
    font-size: 0.65rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* ─── Category Bar ─────────────────────── */
  .nav__categories {
    border-bottom: none;
    background: var(--color-cream);
    box-shadow: inset 0 1px 0 var(--color-cream-dark);
    display: block;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .nav__categories::-webkit-scrollbar { display: none; }

  .nav__categories-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    white-space: nowrap;
    position: relative;
  }

  /* ─── Sliding active indicator ──────────────── */
  .nav__cat-indicator {
    position: absolute;
    bottom: 0;
    height: 2.5px;
    background: var(--color-gold);
    border-radius: 0;
    pointer-events: none;
    opacity: 0;
    transition: left 0.4s var(--ease-out),
                width 0.4s var(--ease-out),
                opacity 0.2s ease;
  }

  @media (max-width: 767px) {
    .nav__cat-indicator {
      /* Mobile: solid pill behind active tab */
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
      height: 36px;
      border-radius: 0;
      background: var(--color-cream-dark);
    }
  }

  @media (max-width: 767px) {
    .nav__categories {
      padding: 0;
      scroll-snap-type: x proximity;
    }

    .nav__categories-inner {
      justify-content: flex-start;
      padding: 0 10px;
      padding-right: 32px;
    }
  }

  /* ─── Category Links ─────────────────────── */
  .nav__cat-link {
    padding: 0.85rem 1.15rem;
    font-size: 0.88rem;
